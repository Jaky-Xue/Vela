<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>

	<!-- The interface languages Vela answers to.

	     The app's own strings are written in Chinese and carry no .lproj
	     resources, so without this declaration the bundle reports English as
	     its only localization. Every system surface the app hosts then follows
	     English too — most visibly the native video player's menu, which a
	     Chinese-language device renders in English inside Vela while Safari
	     renders it in Chinese. Declaring zh-Hans lets the system resolve the
	     process language to the user's preference, and AVKit's controls
	     follow it. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh-Hans</string>
		<string>en</string>
	</array>

	<!-- Frameworks may speak the user's language even where the app does not
	     have its own translation for a string — the same reason as above, as
	     seen from the framework side. -->
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
	<key>CFBundleDisplayName</key>
	<string>Vela</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>3.9.0</string>
	<key>CFBundleVersion</key>
	<string>3</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Multiple scenes, which is what lets Stage Manager open a second Vela
	     window instead of raising the first one. Each scene builds its own
	     AppEnvironment and therefore its own tab session; the database and the
	     other shared services stay single. Without this key the system treats
	     the app as a single-window app and the second window is impossible to
	     create, whatever the SwiftUI scene says. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>

	<!-- Multitasking is allowed so the iPad layout can be used in Split View,
	     Slide Over and Stage Manager. UIRequiresFullScreen is deliberately
	     absent: it would forbid all of them. The trade-off is that the system's
	     fullscreen video presentation cannot drive rotation from a slide-over
	     card; the native player still fills the page's own window. -->

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Cleartext HTTP inside web content.

	     Without this, App Transport Security blocks every http:// navigation a
	     web view makes, so a browser that accepted the address in the address
	     bar then failed to open it — with an untranslated system message and no
	     path forward. Safari loads those pages and marks them "Not Secure",
	     which is the behaviour a browser owes its user.

	     This is deliberately the web-content key rather than
	     NSAllowsArbitraryLoads: it applies to WKWebView content only, while the
	     app's own networking — downloads, filter-list subscriptions, search
	     engine probes — stays under full ATS enforcement. Nothing here relaxes
	     TLS: certificate validation is untouched, and Vela never trusts a
	     certificate it would otherwise reject. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>

	<!-- External application navigation, mirroring Aira's ExternalNavigationLaunchService.
	     Without these entries canOpenURL always returns false and the prompt never appears. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>http</string>
		<string>https</string>
		<string>tel</string>
		<string>mailto</string>
		<string>sms</string>
		<string>facetime</string>
		<string>itms-apps</string>
		<string>alipay</string>
		<string>alipays</string>
		<string>weixin</string>
		<string>wechat</string>
		<string>taobao</string>
		<string>tmall</string>
		<string>baidumap</string>
		<string>iosamap</string>
		<string>qqmap</string>
		<string>mqq</string>
		<string>sinaweibo</string>
		<string>bilibili</string>
		<string>zhihu</string>
		<string>douyin</string>
		<string>snssdk1128</string>
		<string>orpheuswidget</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Vela 需要使用相机扫描二维码。</string>

	<!-- The password vault unlocks with Face ID (or Touch ID / the device
	     passcode). Without this key the system refuses the Face ID prompt and
	     the vault can only be opened with the passcode. -->
	<key>NSFaceIDUsageDescription</key>
	<string>Vela 使用面容 ID 解锁密码与保险箱。</string>
</dict>
</plist>
